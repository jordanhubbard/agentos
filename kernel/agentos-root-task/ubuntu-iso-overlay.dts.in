/*
 * agentOS Ubuntu live-ISO guest overlay DTS — QEMU virt AArch64.
 *
 * Generated through vmm.mk so linux,initrd-end matches the extracted initrd
 * size from the staged Ubuntu ISO.
 */
/ {
    dma-coherent;

    memory@@UBUNTU_RAM_NODE@ {
        device_type = "memory";
        reg = <@UBUNTU_RAM_BASE@ 0x00 0x20000000>;
    };

    flash@0 {
        status = "disabled";
    };

    aliases {
        serial0 = "/pl011@9000000";
    };

    chosen {
        stdout-path = "serial0:115200n8";
        bootargs = "@UBUNTU_BOOTARGS@";
        linux,stdout-path = "serial0:115200n8";
        linux,initrd-start = <@UBUNTU_INITRD_START@>;
        linux,initrd-end = <@UBUNTU_INITRD_END@>;
    };

    /*
     * QEMU virtio-mmio slot 0 (kill-dated crutch). SSH E2E still uses this
     * until packets are proven through the emulated device below.
     */
    virtio_mmio@a000000 {
        compatible = "virtio,mmio";
        dma-coherent;
        reg = <0x00 0xa000000 0x00 0x200>;
        interrupt-parent = <0x8001>;
        interrupts = <0x00 0x10 0x01>;
    };

    /*
     * agentOS emulated virtio-net. Guest IPA 0xa010000 is not QEMU MMIO;
     * accesses fault into linux_vmm and hit libvmm virtio_mmio_net_init.
     * IRQ: SPI 18 → INTID 50.
     */
    virtio_mmio@a010000 {
        compatible = "virtio,mmio";
        dma-coherent;
        reg = <0x00 0xa010000 0x00 0x1000>;
        interrupt-parent = <0x8001>;
        interrupts = <0x00 0x12 0x01>;
    };

    virtio_mmio@a000200 {
        compatible = "virtio,mmio";
        dma-coherent;
        reg = <0x00 0xa000200 0x00 0x200>;
        interrupt-parent = <0x8001>;
        interrupts = <0x00 0x11 0x01>;
    };

    virtio_mmio@a000600 {
        compatible = "virtio,mmio";
        dma-coherent;
        reg = <0x00 0xa000600 0x00 0x200>;
        interrupt-parent = <0x8001>;
        interrupts = <0x00 0x13 0x01>;
    };
};
