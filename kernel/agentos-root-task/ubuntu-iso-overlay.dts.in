/*
 * agentOS Ubuntu live-ISO guest overlay DTS — QEMU virt AArch64.
 *
 * Generated through vmm.mk so linux,initrd-end matches the extracted initrd
 * size from the staged Ubuntu ISO.
 */
/ {
    dma-coherent;

    memory@@UBUNTU_RAM_NODE@ {
        device_type = "memory";
        reg = <@UBUNTU_RAM_BASE@ 0x00 @UBUNTU_RAM_SIZE@>;
    };

    flash@0 {
        status = "disabled";
    };

    /*
     * Physical PL011 belongs to serial_pd.  Keep only the address-based
     * earlycon from bootargs; suppress the normal AMBA tty driver so hvc0 is
     * the sole usable Ubuntu console after early boot.
     */
    pl011@9000000 {
        status = "disabled";
    };

    chosen {
        bootargs = "@UBUNTU_BOOTARGS@";
        linux,initrd-start = <@UBUNTU_INITRD_START@>;
        linux,initrd-end = <@UBUNTU_INITRD_END@>;
    };

    /*
     * agentOS emulated virtio-net. Guest IPA 0xa010000 is not QEMU MMIO;
     * accesses fault into linux_vmm and hit libvmm virtio_mmio_net_init.
     * IRQ: SPI 18 → INTID 50.
     */
    virtio_mmio@a010000 {
        compatible = "virtio,mmio";
        dma-coherent;
        reg = <0x00 0xa010000 0x00 0x1000>;
        interrupt-parent = <0x8001>;
        interrupts = <0x00 0x12 0x01>;
    };

    /*
     * agentOS emulated virtio-console backed by sDDF serial queues.
     * PL011 is earlycon only; hvc0 carries the usable console and login.
     * IRQ: SPI 21 -> INTID 53.
     */
    virtio_mmio@a030000 {
        compatible = "virtio,mmio";
        dma-coherent;
        reg = <0x00 0xa030000 0x00 0x1000>;
        interrupt-parent = <0x8001>;
        interrupts = <0x00 0x15 0x01>;
    };

    /* agentOS emulated virtio-blk RAM backend. SPI 20 -> INTID 52. */
    virtio_mmio@a020000 {
        compatible = "virtio,mmio";
        dma-coherent;
        reg = <0x00 0xa020000 0x00 0x1000>;
        interrupt-parent = <0x8001>;
        interrupts = <0x00 0x14 0x01>;
    };
};
